# Copy to .env and replace placeholders using the connection details shown in FalkorDB Cloud.
FALKORDB_HOST=replace-with-cloud-hostname
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Set this only according to the instance's displayed connection instructions.
FALKORDB_SSL=
FALKORDB_GRAPH=tenant_hashira_demo

# Gemini is optional. Set an API key only in your local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
